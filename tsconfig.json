{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"jsx": "react-native",
		"resolveJsonModule": true,
    	"esModuleInterop": true,
		"paths": {
			"@/*": ["./*"]
		},
		"types": ["jest"],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".expo/types/**/*.ts",
		"expo-env.d.ts",
		"nativewind-env.d.ts"
	],
	"exclude": ["node_modules"]
}
